    "prettier": "3.8.3",
    "sort-package-json": "^3.7.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1"
  },
