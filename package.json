  },
  "license": "MIT",
  "author": "Candee Generations <admin@candeegenerations.com>",
  "scripts": {
    "build": "NEXT_PUBLIC_APP_VERSION=$npm_package_version next build",
    "dev": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next dev -p 4848",
    "eslint": "eslint 'src/**/*.{ts,tsx}'",
    "fix": "pnpm run eslint && pnpm run prettier --cache",
    "preinstall": "npx only-allow pnpm",
    "install:ci": "pnpm install --ignore-scripts",
    "prepare": "husky",
    "prettier": "prettier --cache --check --write --ignore-unknown .",
    "prettier:ci": "pnpm exec prettier --check .",
    "release": "standard-version -a -- --release-as minor",
    "start": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next start"
  },
  "resolutions": {
    "minimatch": "^9.0.7"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.15.8",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "dayjs": "^1.11.19",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
