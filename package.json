{
  "name": "cbc-countdown",
  "version": "1.1.34",
  "private": true,
  "description": "Countdown to the next service",
  "homepage": "https://github.com/CandeeGenerations/cbc-countdown#readme",
  "bugs": {
    "url": "https://github.com/CandeeGenerations/cbc-countdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:CandeeGenerations/cbc-countdown.git"
  },
  "license": "MIT",
  "author": "Candee Generations <admin@candeegenerations.com>",
  "scripts": {
    "build": "NEXT_PUBLIC_APP_VERSION=$npm_package_version next build",
    "dev": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next dev -p 4848",
    "fix": "pnpm run lint:fix && pnpm run prettier --cache",
    "preinstall": "npx only-allow pnpm",
    "install:ci": "pnpm install --ignore-scripts",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "prepare": "husky",
    "prettier": "prettier --cache --check --write --ignore-unknown .",
    "prettier:ci": "pnpm exec prettier --check .",
    "release": "standard-version -a -- --release-as minor",
    "start": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next start"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "5.16.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "dayjs": "1.11.23",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "17.5.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.7",
    "sort-package-json": "^4.0.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
