{
  "name": "cbc-countdown",
  "version": "1.1.34",
  "private": true,
  "description": "Countdown to the next service",
  "homepage": "https://github.com/CandeeGenerations/cbc-countdown#readme",
  "bugs": {
    "url": "https://github.com/CandeeGenerations/cbc-countdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:CandeeGenerations/cbc-countdown.git"
  },
  "license": "MIT",
  "author": "Candee Generations <admin@candeegenerations.com>",
  "scripts": {
    "build": "NEXT_PUBLIC_APP_VERSION=$npm_package_version next build",
    "dev": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next dev -p 4848",
    "eslint": "eslint 'src/**/*.{ts,tsx}'",
    "fix": "pnpm run eslint && pnpm run prettier --cache",
    "preinstall": "npx only-allow pnpm",
    "install:ci": "pnpm install --ignore-scripts",
    "prepare": "husky",
    "prettier": "prettier --cache --check --write --ignore-unknown .",
    "prettier:ci": "pnpm exec prettier --check .",
    "release": "standard-version -a -- --release-as minor",
    "start": "fnm use; NEXT_PUBLIC_APP_VERSION=$npm_package_version next start"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "5.15.13",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "dayjs": "1.11.23",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "25.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "sort-package-json": "^4.0.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
